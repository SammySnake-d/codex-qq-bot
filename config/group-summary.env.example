# Required target and send gate.
QQ_SUMMARY_GROUP_IDS=123456789
QQ_SUMMARY_SEND_ENABLED=0
# group sends back to each source group; private sends every summary to one friend.
QQ_SUMMARY_DELIVERY_MODE=private
QQ_SUMMARY_DELIVERY_USER_ID=2909951742

# OneBot / NapCat.
ONEBOT_API_BASE=http://127.0.0.1:3000
ONEBOT_ACCESS_TOKEN=
# Optional. If empty, the worker calls get_login_info.
QQ_SUMMARY_SELF_ID=

# codex or claude.
QQ_SUMMARY_PROVIDER=codex
QQ_SUMMARY_MODEL=
QQ_SUMMARY_REASONING_EFFORT=low
QQ_SUMMARY_PROVIDER_TIMEOUT_MS=180000
QQ_SUMMARY_MAX_BUDGET_USD=

# Cron usually has a minimal PATH. Absolute executable paths are recommended.
NODE_BIN=
CODEX_CLI_PATH=codex
# Default: derive a minimal isolated CODEX_HOME from the active provider config.
QQ_SUMMARY_CODEX_HOME=runtime/group-summary-codex-home
# Set to 1 only when the default OpenAI provider/auth works without config.toml.
QQ_SUMMARY_CODEX_IGNORE_USER_CONFIG=0

CLAUDE_CLI_PATH=claude
# --bare requires API-key auth. The default uses --safe-mode so OAuth/keychain auth can work.
QQ_SUMMARY_CLAUDE_BARE=0

# Persistent state and history synchronization.
QQ_SUMMARY_DB_PATH=data/group-summary.sqlite
QQ_SUMMARY_HISTORY_BATCH_SIZE=200
QQ_SUMMARY_MAX_HISTORY_PAGES=100
QQ_SUMMARY_MAX_MESSAGES_PER_RUN=30000
QQ_SUMMARY_CHUNK_SIZE=1500
QQ_SUMMARY_CHUNK_MAX_CHARS=240000

# Eligibility policy.
QQ_SUMMARY_MIN_MESSAGES=1500
QQ_SUMMARY_MIN_SPEAKERS=3
QQ_SUMMARY_QUIET_MINUTES=20
QQ_SUMMARY_MIN_INTERVAL_MINUTES=120
QQ_SUMMARY_DUE_MIN_MINUTES=120
QQ_SUMMARY_DUE_MAX_MINUTES=360
QQ_SUMMARY_LOW_ACTIVITY_MIN_MINUTES=30
QQ_SUMMARY_LOW_ACTIVITY_MAX_MINUTES=90
QQ_SUMMARY_ACTIVE_CHAT_MIN_MINUTES=15
QQ_SUMMARY_ACTIVE_CHAT_MAX_MINUTES=30
QQ_SUMMARY_ACTIVE_HOURS=08:00-23:30
QQ_SUMMARY_MAX_RENDERED_CHARS=900
